# Hosting Apache (FTP): el sitio está prerenderizado, cada ruta es un HTML real.
# /perfumes            -> perfumes/index.html
# /perfumes/<slug>     -> perfumes/<slug>.html
# index.html antes que el default.php de Hostinger (no hace falta borrarlo).
DirectoryIndex index.html
DirectorySlash Off
Options -Indexes

# Tipos que el servidor no trae por defecto (sin esto sirve .avif como text/plain).
AddType image/avif .avif
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType video/mp4 .mp4

RewriteEngine On

# Dominio principal sin www, en un solo salto (también quita la barra final).
# Si el carrito o la intro se guardaran en www, se perderían al pasar al otro.
RewriteCond %{HTTP_HOST} ^www\.narcisoparfum\.com$ [NC]
RewriteRule ^(.*?)/?$ https://narcisoparfum.com/$1 [L,R=301]

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /index.html -> /   y   /perfumes/index.html -> /perfumes
RewriteCond %{THE_REQUEST} \s/+(.*?)/?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,NE,L]
# /perfumes/<slug>.html -> /perfumes/<slug>  (/404.html se deja tal cual).
# THE_REQUEST no cambia en las reescrituras internas: no hay bucle.
RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,NE,L]

# Carpetas sin index.html (/img, /brand, /assets): 404 directo. LiteSpeed
# ignora DirectorySlash Off y añadiría la barra, que la regla siguiente quita:
# sin esto, bucle infinito de 301.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

RewriteRule ^(.+)/$ /$1 [L,R=301]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html

# Caché: las fotos, el logo y los íconos no llevan hash (se reemplazan con el
# mismo nombre), así que se revalidan cada semana. Lo que tiene hash vive en
# /assets y se guarda un año (assets/.htaccess). El HTML, siempre fresco.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType video/mp4 "access plus 7 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml text/xml
</IfModule>
